---
// Скриншот из руководства с увеличением по щелчку.
const { lang, file, alt, eager = false } = Astro.props;
const base = `/shots/${lang}/${file}`;
---
<a class="shot" href={`${base}.webp`} data-zoom={alt}>
  <img src={`${base}.webp`} srcset={`${base}-800.webp 800w, ${base}.webp 1600w`} sizes="(max-width: 900px) 100vw, 640px"
    width="1600" height="1000" alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
</a>
